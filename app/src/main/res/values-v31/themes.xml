<resources>
    <style name="Theme.VRKA" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#121216</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/vrka_icon_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_vrka_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/vrka_icon_background</item>
    </style>
</resources>
