    <string name="desc_amoled">இருண்ட பயன்முறை செயலில் இருக்கும்போது தூய கருப்பு பின்னணியைப் பயன்படுத்தவும்</string>
    <string name="desc_auto_app_updates">தொடங்கும்போது VRKA பயன்பாட்டுப் புதுப்பிப்புகளைச் சரிபார்க்கவும்</string>
    <string name="desc_auto_check_launch">பயன்பாடு தொடங்கும் போது yt-dlp கூறு புதுப்பிப்புகளைச் சரிபார்க்கவும்</string>
    <string name="desc_browser_session_default">தனியார் ஃபால்பேக் அமர்வு. குக்கீகள், தள சேமிப்பகம், தற்காலிக சேமிப்பு ஆகியவற்றை அழிக்கவும்.</string>
    <string name="desc_check_releases">புதிய வெளியீடுகளுக்கு GitHub-ஐப் பார்க்கவும்</string>
    <string name="desc_checking_updates">புதுப்பிப்புகளைச் சரிபார்க்கிறது...</string>
    <string name="desc_concurrency_warning">ஒரே நேரத்தில் பல பதிவிறக்கங்களை இயக்குவது அதிக CPU, நினைவகம், நெட்வொர்க் அலைவரிசை, சேமிப்பக I/O மற்றும் பேட்டரியைப் பயன்படுத்துகிறது. நிலைத்தன்மைக்காக இயல்புநிலையாக முடக்கப்பட்டுள்ளது.</string>
    <string name="desc_concurrent_disabled">முடக்கப்பட்டது (பதிவிறக்கங்கள் வரிசையாக ஒவ்வொன்றாகச் செயல்படுத்தப்படும்)</string>
    <string name="desc_concurrent_enabled">இயக்கப்பட்டது (%1$d பதிவிறக்கங்கள் வரை ஒரே நேரத்தில் செயல்படுத்தப்படும்)</string>
    <string name="desc_custom_commands_disabled">முடக்கப்பட்டது • சாதாரண VRKA பதிவிறக்க விருப்பங்கள் பயன்படுத்தப்படுகின்றன</string>
    <string name="desc_custom_commands_enabled">இயக்கப்பட்டது • புதிய பதிவிறக்கங்கள் தேர்ந்தெடுக்கப்பட்ட டெம்ப்ளேட்டைப் பயன்படுத்துகின்றன</string>
    <string name="desc_custom_commands_helper">டெம்ப்ளேட்டுகள் வாதப் பட்டியல்கள், ஷெல் கட்டளைகள் அல்ல. VRKA பாதுகாப்பற்ற பாதைகள் மற்றும் நற்சான்றிதழ்களைத் தடுக்கிறது.</string>
    <string name="desc_h264_disabled">இயல்புநிலையாக முடக்கப்பட்டுள்ளது; மூல கோடெக்கைப் பாதுகாக்கவும்</string>
    <string name="desc_h264_enabled">பதிவிறக்கத்திற்குப் பிறகு H.264 அல்லாத வீடியோவை மாற்றவும்; தற்போதுள்ள H.264 நகலெடுக்கப்படும்</string>
    <string name="desc_h264_helper">H.264 மாற்றம் அதிக நேரம் எடுக்கலாம் மற்றும் கூடுதல் பேட்டரி மற்றும் CPU-ஐப் பயன்படுத்தலாம். VRKA பதிவிறக்கம் செய்யப்பட்ட கோடெக்கைச் சரிபார்த்து ஏற்கனவே H.264 ஆக இருந்தால் மாற்றத்தைத் தவிர்க்கிறது.</string>
    <string name="desc_location_prompt">ஒவ்வொரு பதிவிறக்கத்திற்கும் ஒரு இருப்பிடத்தைத் தேர்ந்தெடுக்க நீங்கள் கேட்கப்படுவீர்கள்.</string>
    <string name="desc_location_selected">பதிவிறக்கங்கள் நேரடியாகத் தேர்ந்தெடுக்கப்பட்ட இடத்தில் சேமிக்கப்படும்.</string>
    <string name="desc_media_detection">WebExtension • நேரடி ஊடகம், HLS மற்றும் DASH கண்டறிதல்</string>
    <string name="desc_size_confirmation_disabled">பதிவிறக்கங்களுக்கு முன் அளவு மதிப்பீடுகள் தவிர்க்கப்படும்</string>
    <string name="desc_size_confirmation_enabled">ஒவ்வொரு பதிவிறக்கத்திற்கும் முன் மெட்டாடேட்டாவிலிருந்து பதிவிறக்க அளவை மதிப்பிடு</string>
    <string name="desc_size_confirmation_helper">yt-dlp மெட்டாடேட்டாவை மட்டுமே பயன்படுத்துகிறது; அளவைக் கணக்கிட எதுவும் பதிவிறக்கப்படாது. தோராயமான மதிப்புகள் தோராயமானவை எனக் குறிக்கப்படும்.</string>
